# Copy to deploy/.env.api or deploy/.env.worker (ignored by Git).
API_IMAGE=lyrics-api:local
WORKER_IMAGE=lyrics-worker:local
API_DOMAIN=lyrics.example.com
ACME_EMAIL=you@example.com
SUPABASE_URL=https://your-project-ref.supabase.co
# Copy the real connection URI from Supabase Connect; URL-encode password.
# Prefer session pooler :5432 on IPv4-only hosts; use verified TLS.
DATABASE_URL=postgresql://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@YOUR_SESSION_POOLER_HOST:5432/postgres?sslmode=verify-full
OLLAMA_MODEL=translategemma:4b
OLLAMA_IMAGE=ollama/ollama:0.35.0
OLLAMA_MODELS_PATH=/srv/ollama/models
OLLAMA_TIMEOUT_SECONDS=180
OLLAMA_MAX_ATTEMPTS=3
